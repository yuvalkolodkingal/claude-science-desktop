# Maintainer: Yuval <yuvalkgal@gmail.com>
#
# Unofficial desktop wrapper for Claude Science. Ships no Anthropic code: the
# daemon is downloaded by the app at first run from downloads.claude.ai and
# verified against Anthropic's published checksum.
pkgname=claude-science-desktop
pkgver=0.1.0
pkgrel=1
pkgdesc="Unofficial desktop window for Claude Science (downloads Claude Science on first run)"
arch=('x86_64')
url="https://github.com/yuvalkolodkingal/claude-science-desktop"
license=('MIT')
depends=('gtk3' 'libnotify' 'nss' 'libxss' 'libxtst' 'xdg-utils' 'at-spi2-core' 'libsecret')
optdepends=('claude-science: use an existing install instead of the app-managed copy')
options=('!strip' '!debug')
_raw="https://raw.githubusercontent.com/yuvalkolodkingal/claude-science-desktop/v$pkgver"
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/claude-science-desktop-linux-x64.tar.gz"
        "LICENSE-$pkgver::$_raw/LICENSE"
        "$pkgname-$pkgver.png::$_raw/build/icon.png")
# Fill in with: updpkgsums
sha256sums=('SKIP'
            'SKIP'
            'SKIP')

package() {
  install -dm755 "$pkgdir/opt/$pkgname"
  cp -a "$srcdir/$pkgname-linux-x64/." "$pkgdir/opt/$pkgname/"

  # Electron's chrome-sandbox needs the setuid bit on Arch.
  chmod 4755 "$pkgdir/opt/$pkgname/chrome-sandbox" 2>/dev/null || true

  install -dm755 "$pkgdir/usr/bin"
  ln -s "/opt/$pkgname/$pkgname" "$pkgdir/usr/bin/$pkgname"

  install -Dm644 "$srcdir/$pkgname-$pkgver.png" \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/$pkgname.png"

  install -dm755 "$pkgdir/usr/share/applications"
  cat > "$pkgdir/usr/share/applications/$pkgname.desktop" <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Claude Science Desktop
GenericName=Local research workspace
Comment=Unofficial desktop window for Claude Science
Exec=/usr/bin/$pkgname %U
Icon=$pkgname
Terminal=false
StartupNotify=true
StartupWMClass=$pkgname
Categories=Science;
Keywords=Claude;AI;Research;
EOF

  install -Dm644 "$srcdir/LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
